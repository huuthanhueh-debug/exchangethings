# Mẫu cấu hình. Chép thành .env.local (máy dev) hoặc đặt trong Vercel (bản online). Không commit giá trị thật.

# --- Database ---
# Máy dev: Postgres local. Bản online: chuỗi kết nối Supabase qua pooler (chế độ transaction, cổng 6543).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/exchangethings_dev
# Database ở xa luôn kết nối TLS có kiểm tra chứng chỉ. Với Supabase, app đã kèm sẵn CA gốc của Supabase nên để trống.
# Chỉ đặt (PEM) khi dùng database khác có CA riêng.
DATABASE_CA_CERT=

# --- Đăng nhập ---
# supabase: link qua email và Google (bản online). dev: đăng nhập bằng người dùng mẫu, chỉ chạy được khi
# DATABASE_URL trỏ về localhost và không chạy trên Vercel.
AUTH_MODE=dev
# Bắt buộc khi AUTH_MODE=dev, tối thiểu 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEV_AUTH_SECRET=

# --- Supabase (bắt buộc khi AUTH_MODE=supabase hoặc STORAGE_DRIVER=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Khóa bí mật (secret key): chỉ đặt trên server, không bao giờ để lộ ra trình duyệt.
SUPABASE_SECRET_KEY=

# --- Lưu ảnh ---
# local: thư mục trên máy dev. supabase: Supabase Storage (bucket riêng tư, signed URL 10 phút).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage

# Địa chỉ gốc của app, dùng cho link đăng nhập gửi qua email.
APP_URL=http://localhost:3000
